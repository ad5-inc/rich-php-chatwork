{
    "name": "ad5-inc/rich-php-chatwork",
    "description": "Laravel の例外を、値を送らずに読みやすい形で Chatwork に知らせる",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ad5jp/php-chatwork": "^1.0.3",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "google/apiclient": "^2.18",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "google/apiclient": "Google の API の失敗で、HTTP の状態と reason を知らせに添える"
    },
    "autoload": {
        "psr-4": {
            "Ad5\\RichPhpChatwork\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ad5\\RichPhpChatwork\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ad5\\RichPhpChatwork\\RichChatworkServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
